# HTTPSの公開ホスト名（パス・ポートなし）。ローカル確認時は未設定でも起動できます。
FEED_HOSTNAME=feeds.example.com
# フィードを公開するBlueskyアカウントのDID。ハンドルではありません。
FEED_PUBLISHER_DID=did:plc:replace-with-your-did
FEED_RKEY=aozora-jp
DATABASE_PATH=data/feed.sqlite3
PORT=8000
JETSTREAM_URLS=wss://jetstream2.us-west.bsky.network/subscribe,wss://jetstream1.us-east.bsky.network/subscribe
STREAM_ENABLED=true
# 初回起動時に24時間前からリプレイを要求。提供元の保持期間で取得範囲は変わります。
BACKFILL_HOURS=24
SNAPSHOT_TTL_SECONDS=900
MAX_POSTS_PER_AUTHOR=3
MAX_FEED_POSTS=1000
# 約30%を反応の少ない新着紹介枠にする（0なら従来のランキングのみ）。
DISCOVERY_PERCENT=30
DISCOVERY_MAX_AGE_HOURS=3
DISCOVERY_MAX_INTERACTIONS=5
DISCOVERY_MAX_AUTHOR_INTERACTIONS=20
EXCLUDE_REPLIES=true
INCLUDE_JAPAN_TOPICS=true
# 任意：採用する投稿者を限定／除外するDID。空欄なら限定しません。
ALLOWED_AUTHOR_DIDS=
BLOCKED_AUTHOR_DIDS=
# 空欄なら推測困難なカーソル署名鍵をSQLiteに自動生成・保存します。
CURSOR_SECRET=
# 以下は公開登録コマンドのみで使用。アプリパスワードをリポジトリに含めないでください。
BSKY_SERVICE=https://bsky.social
BSKY_IDENTIFIER=
BSKY_APP_PASSWORD=
